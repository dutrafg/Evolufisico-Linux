project('evolufisico-linux', 'c', version: '0.1.0', default_options: ['warning_level=2', 'c_std=c11'])
gtk = dependency('gtk4', version: '>=4.10')
sqlite = dependency('sqlcipher')
executable('evolufisico-linux', ['src/main.c', 'src/storage.c', 'src/folder_settings.c', 'src/auto_backup.c', 'src/drive_sync.c', 'src/cloud_sync.c'], dependencies: [gtk, sqlite], install: true)
smoke = executable('storage-smoke', ['tests/storage-smoke.c', 'src/storage.c'], dependencies: [gtk, sqlite])
test('sqlite-storage', smoke)
folder_smoke = executable('folder-settings', ['tests/folder-settings.c', 'src/folder_settings.c'], dependencies: [gtk])
test('folder-settings', folder_smoke)
auto_backup_smoke = executable('auto-backup', ['tests/auto-backup.c', 'src/auto_backup.c', 'src/storage.c', 'src/folder_settings.c'], dependencies: [gtk, sqlite])
test('auto-backup', auto_backup_smoke)
drive_smoke = executable('drive-sync', ['tests/drive-sync.c', 'src/drive_sync.c', 'src/folder_settings.c', 'src/storage.c'], dependencies: [gtk, sqlite])
test('drive-sync', drive_smoke)
cloud_smoke = executable('cloud-sync', ['tests/cloud-sync.c', 'src/cloud_sync.c', 'src/drive_sync.c', 'src/folder_settings.c', 'src/storage.c'], dependencies: [gtk, sqlite])
test('cloud-sync', cloud_smoke, timeout: 120)
install_data('data/br.com.evolufisico.desktop', install_dir: get_option('datadir') / 'applications')
